# AI model for the daily briefing: ollama | none
# Without a reachable model the app uses the rules engine's own wording.
AVRORA_LLM=ollama

# OTH KIGS server (Open WebUI in front of Ollama).
# Create a key in Open WebUI > Settings > Account > API keys.
OLLAMA_HOST=https://im-kigs-openwebui.oth-regensburg.de/ollama
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen3:32b

# Or a local Ollama:
# OLLAMA_HOST=http://localhost:11434
