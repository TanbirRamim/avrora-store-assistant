# Store AI: any OpenAI-compatible chat-completions API (self-hosted or hosted).
# AI_BASE_URL is the part before /chat/completions, e.g. https://your-host/v1
# Leave AI_BASE_URL empty to run without AI: the app then uses the rules engine's own wording.
AI_BASE_URL=
# AI_MODEL may list fallbacks, comma separated: a,b,c (the next answers when one is busy)
AI_MODEL=
AI_REASONING_EFFORT=
AI_API_KEY=

# Optional instead: a local Ollama through its native API
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=

# Set to none to switch every model call off (tests do this).
# AVRORA_LLM=none

# Map > War-time: live air-raid alerts from https://alerts.in.ua (optional; without it risk uses distance only)
ALERTS_IN_UA_TOKEN=

# Local API hardening
# Host names the API answers to (comma separated); other Host headers get 400 (DNS rebinding).
# AVRORA_ALLOWED_HOSTS=localhost,127.0.0.1
# Browser origins allowed to call the API (CORS and the same-origin guard on write requests).
# AVRORA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Only behind a reverse proxy that overwrites this header: where to read the client address for rate limits.
# AVRORA_CLIENT_IP_HEADER=
# Required for POST/DELETE /api/signals/simulate (sent as X-Demo-Key). Empty or unset = those routes answer 403.
AVRORA_DEMO_KEY=
